# Python import and the native importer share this reviewed identity registry.
set(adf_registry "${PROJECT_SOURCE_DIR}/setup/adf-sources.json")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${adf_registry}")
file(READ "${adf_registry}" adf_json)
set(adf_header "#pragma once\n#include <array>\n#include <cstddef>\n#include <cstdint>\nnamespace scr::runtime::detail {\n")
foreach(field adf_bytes disk_offset payload_bytes load_address)
  string(JSON value GET "${adf_json}" "${field}")
  string(APPEND adf_header "inline constexpr std::uint32_t ${field} = ${value};\n")
endforeach()
string(JSON adf_count LENGTH "${adf_json}" sources)
if(adf_count LESS 1)
  message(FATAL_ERROR "The ADF identity registry is empty")
endif()
math(EXPR adf_last "${adf_count} - 1")
string(APPEND adf_header "struct AdfSource { const char* name; const char* sha256; const char* payload_sha256; };\ninline constexpr std::array<AdfSource, ${adf_count}> adfSources{{\n")
foreach(index RANGE 0 ${adf_last})
  foreach(field name sha256 payload_sha256)
    string(JSON ${field} GET "${adf_json}" sources ${index} ${field})
  endforeach()
  foreach(digest "${sha256}" "${payload_sha256}")
    string(LENGTH "${digest}" digest_length)
    if(NOT digest_length EQUAL 64 OR NOT digest MATCHES "^[0-9a-f]+$")
      message(FATAL_ERROR "Invalid SHA-256 in the ADF identity registry")
    endif()
  endforeach()
  if(NOT name MATCHES "^[A-Za-z0-9 ()+-]+$")
    message(FATAL_ERROR "ADF names must be plain ASCII labels")
  endif()
  string(APPEND adf_header "  {\"${name}\", \"${sha256}\", \"${payload_sha256}\"},\n")
endforeach()
string(APPEND adf_header "}};\n}\n")
file(MAKE_DIRECTORY "${PROJECT_BINARY_DIR}/generated")
file(CONFIGURE OUTPUT "${PROJECT_BINARY_DIR}/generated/supported_adf_sources.h" CONTENT "${adf_header}" @ONLY)
target_include_directories(scr_runtime PRIVATE "${PROJECT_BINARY_DIR}/generated")
