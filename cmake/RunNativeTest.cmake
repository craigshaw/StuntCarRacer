# Reset only this suite's generated output. Resolve and check the path before
# recursive removal so a redirected directory cannot reach source or evidence.
file(REAL_PATH "${TEST_BUILD_ROOT}" build_root)
file(REAL_PATH "${TEST_OUTPUT}" output_root)
set(expected_root "${build_root}/test-output")
cmake_path(IS_PREFIX expected_root "${output_root}" NORMALIZE output_is_local)
if(NOT output_is_local OR output_root STREQUAL expected_root)
  message(FATAL_ERROR "Refusing to reset test output outside the build's test-output directory")
endif()
file(REMOVE_RECURSE "${output_root}")
if(EXISTS "${output_root}")
  message(FATAL_ERROR "Cannot reset generated test output: ${output_root}")
endif()
file(MAKE_DIRECTORY "${output_root}")
if(TEST_INPUT AND NOT EXISTS "${TEST_INPUT}")
  message("SKIP: missing local test input: ${TEST_INPUT}")
  return()
endif()
# Raw payload tests must use the supported disk's recovered plaintext, not an
# arbitrary local binary. Pack readers independently verify the asset identity.
if(TEST_INPUT AND TEST_INPUT STREQUAL TEST_PAYLOAD)
  file(SHA256 "${TEST_INPUT}" payload_sha)
  if(NOT payload_sha STREQUAL "508646f12af15115de73b06940c79e579f920bf47ce55f7cd8920eca60b7921c")
    message(FATAL_ERROR "Original test payload SHA-256 differs from the supported disk")
  endif()
endif()
if(NOT EXISTS "${TEST_EXECUTABLE}")
  message(FATAL_ERROR "Missing ${TEST_EXECUTABLE}; build the selected preset before running CTest")
endif()
if(TEST_EXECUTABLE MATCHES "[/\\]native_launcher_tests\\.exe$" AND EXISTS "${TEST_ADF}")
  list(APPEND TEST_ARGUMENTS "${TEST_ADF}")
endif()
execute_process(COMMAND "${TEST_EXECUTABLE}" ${TEST_ARGUMENTS}
  RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
file(WRITE "${TEST_OUTPUT}/stdout.txt" "${output}")
file(WRITE "${TEST_OUTPUT}/stderr.txt" "${error}")
message("${output}${error}")
if(NOT result STREQUAL "0")
  message(FATAL_ERROR "Native test failed (${result})")
endif()
